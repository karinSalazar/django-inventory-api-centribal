# --- Configuración de Base de Datos (MariaDB) ---
DB_NAME=centribal_db
DB_USER=centribal_user
DB_PASSWORD=centribal_pass
DB_ROOT_PASSWORD=root
DB_HOST=db
DB_PORT=3306

# --- Configuración de la API (Django) ---
DEBUG=True
# Generar una clave aleatoria para producción, aquí una de ejemplo:
SECRET_KEY=django-insecure-tu-clave-aqui-sustituyeme

# --- Puertos de Docker ---
API_PORT=8000
